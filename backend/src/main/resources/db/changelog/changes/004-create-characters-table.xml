<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-characters-table" author="shortdrama">
        <createTable tableName="characters">
            <column name="id" type="BINARY(16)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="novel_id" type="BINARY(16)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="gender" type="VARCHAR(50)"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="personality" type="VARCHAR(100)"/>
            <column name="appearance" type="VARCHAR(100)"/>
            <column name="reference_image_url" type="VARCHAR(500)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="characters" baseColumnNames="novel_id"
                                 constraintName="fk_characters_novel"
                                 referencedTableName="novels"
                                 referencedColumnNames="id"/>

        <createIndex indexName="idx_characters_novel_id" tableName="characters">
            <column name="novel_id"/>
        </createIndex>

        <createIndex indexName="idx_characters_status" tableName="characters">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
